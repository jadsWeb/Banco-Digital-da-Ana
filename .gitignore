## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Rider
.idea/

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio 2019/2022 config folders
.vs/
.vscode/

# Autogenerated files
*.generated.cs

# Backup & temporary files
*.tmp
*.bak
*.swp
*~
*.dbmdl
*.dbproj.schemaview

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NCrunch
_NCrunch_*
.*crunch*.local.xml

# NuGet
*.nupkg
*.snupkg
*.nuspec
packages/
*.nuget.props
*.nuget.targets

# Azure build outputs
csx/
*.build.csdef

# Publish outputs
*.publishsettings
app.publish/
**/Properties/PublishProfiles/*.pubxml
**/Properties/PublishProfiles/*.pubxml.user

# Local configuration files
appsettings.Development.json
appsettings.Local.json
secrets.json

# Entity Framework migrations (optional)
# Uncomment if you auto-generate migrations and don’t want to commit them
# Migrations/

# Windows image file caches
Thumbs.db
ehthumbs.db

# OS generated files
.DS_Store*
Icon?
desktop.ini

# Resharper
_ReSharper*/
*.DotSettings.user

# Coverage results
*.coverage
*.coveragexml

# Logs
*.log

# Docker
**/docker-compose.override.yml
**/Dockerfile.*

# JetBrains Rider
.idea/
*.sln.iml

# Temp data (if using file-based DBs for tests)
*.sqlite
*.db

# Optional: ignore generated static files (if using Angular/React inside ASP.NET)
ClientApp/node_modules/
ClientApp/dist/

/bin
/obj